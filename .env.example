# ── Local development environment ─────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# The app runs with SPRING_PROFILES_ACTIVE=demo, same as production.
# Start Postgres first: docker-compose up -d
# Then run the app:     ./mvnw spring-boot:run -Dspring-boot.run.profiles=demo

# ── PostgreSQL (matches docker-compose.yml defaults) ──────────────────────────
PGHOST=localhost
PGPORT=5432
PGDATABASE=crossfit_db
PGUSER=crossfit_user
PGPASSWORD=crossfit_pass

# ── Security ──────────────────────────────────────────────────────────────────
# Must be at least 256 bits (32 chars). Use any random string for local dev.
JWT_SECRET=local-dev-secret-change-me-at-least-256-bits-long-xxx

# ── Google Sheets ─────────────────────────────────────────────────────────────
# Paste the full contents of the service account JSON on a single line.
# Leave blank to disable Sheets integration locally.
GOOGLE_CREDENTIALS_JSON=
GOOGLE_SHEETS_SPREADSHEET_ID=1LUksfUebyzp2ZeplLAFEmOlvwbgBOOlw25JU7ivbUgk

# ── AI ────────────────────────────────────────────────────────────────────────
# Local: Ollama runs automatically if installed (http://localhost:11434).
# Leave ANTHROPIC_API_KEY blank to use Ollama instead.
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ── Password reset email (Gmail SMTP) ─────────────────────────────────────────
# Use a Gmail address + an App Password (not your regular password):
# https://myaccount.google.com/apppasswords
# Leave blank to disable password reset locally (emails will fail silently, logged as an error).
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
# Base URL used to build the reset link sent by email. Defaults to the
# production GitHub Pages URL if unset — override for local testing.
FRONTEND_URL=

# ── Other ─────────────────────────────────────────────────────────────────────
EXERCISEDB_API_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:9090
